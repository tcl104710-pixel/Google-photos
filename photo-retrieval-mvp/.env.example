# =============================================================================
# photo-retrieval-mvp — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development           # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=DEBUG               # DEBUG | INFO | WARNING | ERROR

# ── Google OAuth 2.0 (Google Cloud Console → APIs & Services → Credentials) ──
# Required: enable "Google Photos Library API" in your Google Cloud project first.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# ── Groq API (https://console.groq.com) ──────────────────────────────────────
# Primary LLM: Llama 3.3 70B. Fallback: Mixtral 8x7B.
GROQ_API_KEY=your_groq_api_key_here
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.2

# ── BGE Embedding Models (downloaded locally — no API key required) ───────────
# Models are stored in ./models_cache/ by default.
# Download: python -c "from FlagEmbedding import BGEM3FlagModel; BGEM3FlagModel('BAAI/bge-m3')"
BGE_M3_MODEL_PATH=BAAI/bge-m3
BGE_VISUALIZED_MODEL_PATH=BAAI/bge-visualized-m3
EMBEDDING_DEVICE=cpu          # cpu | cuda | mps (Apple Silicon)
EMBEDDING_BATCH_SIZE=8        # Reduce if out-of-memory; increase if GPU available

# ── FAISS Vector Index ────────────────────────────────────────────────────────
FAISS_INDEX_DIR=./data/faiss_indices
# Index type: flat (small libraries <10k), ivf (large libraries >10k)
FAISS_INDEX_TYPE=flat
FAISS_IVF_NLIST=100           # Only used when FAISS_INDEX_TYPE=ivf

# ── PostgreSQL Database ───────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=photo_retrieval
POSTGRES_USER=photo_user
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://photo_user:change_me_in_production@localhost:5432/photo_retrieval
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=5             # seconds; queries timeout after this

# ── Redis (Session State) ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=               # Leave empty for local dev; set in production
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600      # 1 hour; sessions expire after this period of inactivity

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_strong_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Retrieval Settings ────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=200           # Candidate pool size from ANN search
RETRIEVAL_RESULTS=10          # Results shown to user (top N after re-ranking)
ANN_SIMILARITY_THRESHOLD=0.35 # Min cosine similarity; below this, show clarification
TIME_WINDOW_DEFAULT_MONTHS=24 # Default time window when user gives vague time

# ── Google Photos API ─────────────────────────────────────────────────────────
GOOGLE_PHOTOS_SCOPES=https://www.googleapis.com/auth/photoslibrary.readonly
PHOTOS_SYNC_BATCH_SIZE=50     # Photos fetched per API call
INDEX_UPDATE_INTERVAL_HOURS=24

# ── CORS (Frontend) ───────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Scrapers ──────────────────────────────────────────────────────────────────
# Play Store
PLAYSTORE_APP_ID=com.google.android.apps.photos
PLAYSTORE_REVIEWS_COUNT=100

# YouTube Data API
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_VIDEO_ID=your_video_id_here

# Reddit API (Apify)
APIFY_API_TOKEN=your_apify_api_token_here
REDDIT_SUBREDDIT=googlephotos
REDDIT_POST_LIMIT=100
